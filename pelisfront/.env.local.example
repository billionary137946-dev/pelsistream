# Copiar a ".env.local" y llenar. Nunca subir ".env.local" al repositorio.
# Antes había un backend en Python (pelisback) aparte -- ahora todo vive en
# este mismo proyecto Next.js (API routes en src/app/api/), así que estas
# variables se usan del lado del servidor directamente.

# Cadena de conexión a Supabase Postgres (pooler, puerto 6543)
DATABASE_URL=

# Firma de los tokens de sesión (JWT)
JWT_SECRETO=
JWT_HORAS_EXPIRACION=12
